# ===== Copy this to .env and fill in real values =====
# .env is gitignored. NEVER commit secrets.

# --- Target environment: dev | staging | prod ---
TEST_ENV=staging

# --- App credentials (OrangeHRM demo defaults) ---
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# --- Browser ---
BROWSER=chromium             # chromium | firefox | webkit
HEADLESS=true
SLOW_MO=0                    # ms delay between actions (debug only)

# --- Parallelism ---
PYTEST_WORKERS=auto          # auto | 1 | 2 | 4

# --- Database (optional; only for tests/integration) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orangehrm
DB_USER=hrm_readonly
DB_PASSWORD=changeme

# --- Reporting ---
ALLURE_RESULTS_DIR=reports/allure-results
